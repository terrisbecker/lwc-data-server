generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["camas", "pmn", "users", "watershed_field_data"]
}

// ---------- pmn ----------
model pmn_combined_field_data {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sample_date            DateTime? @db.Date
  sample_time            DateTime? @db.Time(6)
  sampling_site          String?
  air_temperature        Decimal?  @db.Decimal
  weather                String?
  wind_direction         String?
  wind_speed             String?
  barometeric_pressure   Decimal?  @db.Decimal
  water_temperature      Decimal?  @db.Decimal
  ph                     Decimal?  @db.Decimal
  dissolved_oxygen       Decimal?  @db.Decimal
  conductivity           Decimal?  @db.Decimal
  total_dissolved_solids Decimal?  @db.Decimal
  salt_ppt               Decimal?  @db.Decimal
  aphanizomenon          String?
  dolichospermum         String?
  microcystis            String?
  planktothrix           String?
  raphidiopsis           String?
  woronichinia           String?
  secchi                 Decimal?  @db.Decimal
  general_comments       String?
  photos                 String[]  @default([])
  has_scum               Boolean   @default(false)
  scum_photos            String[]  @default([])

  @@schema("pmn")
}

// ---------- camas ----------
model camas_city_data {
  id         String    @id @default(uuid()) @db.Uuid
  location   String?   @db.VarChar(255)
  date       DateTime? @db.Date
  time       DateTime? @db.Time(6)
  depth      Decimal?  @db.Decimal
  temp_c     Decimal?  @db.Decimal
  do_percent Decimal?  @db.Decimal
  do_mg_l    Decimal?  @db.Decimal
  spc_us_cm  Decimal?  @db.Decimal
  c_us_cm    Decimal?  @db.Decimal
  tds_mg_l   Decimal?  @db.Decimal
  ph         Decimal?  @db.Decimal
  chl_a_rfu  Decimal?  @db.Decimal
  phyc_rfu   Decimal?  @db.Decimal
  turbidity  Decimal?  @db.Decimal

  @@schema("camas")
}

// ---------- watershed_field_data ----------
model locations {
  loc_id         String           @id @default(uuid()) @db.Uuid
  loc_name       String
  latitude       Float
  longitude      Float
  description    String?
  phosphate_data phosphate_data[]

  @@schema("watershed_field_data")
}

model phosphate_data {
  id                   String    @id @default(uuid()) @db.Uuid
  lab_case_file_number Int
  loc_id               String    @db.Uuid
  measurement_date     DateTime  @db.Date
  measurement_time     DateTime  @db.Time(6)
  analysis_date        DateTime  @db.Date
  analyte_id           String    @db.VarChar(50)
  analyte_level        Float
  unit                 String    @db.VarChar(50)
  notes                String?
  locations            locations @relation(fields: [loc_id], references: [loc_id], onDelete: NoAction, onUpdate: NoAction)
  photos               String[]  @default([])

  @@schema("watershed_field_data")
}

// ---------- users (RBAC) ----------
model users {
  id            String       @id @default(uuid()) @db.Uuid
  email         String       @unique
  password_hash String
  name          String?
  is_active     Boolean      @default(true)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @updatedAt @db.Timestamptz(6)
  user_roles    user_roles[]
  uploads       upload[]

  @@schema("users")
}

model roles {
  id               String             @id @default(uuid()) @db.Uuid
  name             String             @unique
  description      String?
  user_roles       user_roles[]
  role_permissions role_permissions[]

  @@schema("users")
}

model permissions {
  id               String             @id @default(uuid()) @db.Uuid
  name             String             @unique
  description      String?
  role_permissions role_permissions[]

  @@schema("users")
}

model user_roles {
  user_id     String   @db.Uuid
  role_id     String   @db.Uuid
  assigned_at DateTime @default(now()) @db.Timestamptz(6)
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  roles       roles    @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
  @@schema("users")
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  roles         roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permissions   permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@schema("users")
}

model upload {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  original_name String
  object_key    String   @unique
  content_type  String
  size_bytes    Int
  status        String   @default("pending")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)
  user          users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@schema("users")
}
