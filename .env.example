# Runtime port
PORT=3001

# --- Local Docker Postgres (docker-compose.yml) ---
# DATABASE_URL=postgresql://lwc:lwc@localhost:5432/lwc_data
# DATABASE_SSL=false

# Postgres connection string. If unset, the pg adapter silently falls back to
# localhost:5432 and queries fail with ECONNREFUSED.
DATABASE_URL=postgresql://user:pass@url:port/database

# Set to "false" to disable SSL/TLS on the DB connection. Leave unset for AWS
# RDS (which requires SSL); set false only for a plain local Postgres.
DATABASE_SSL=false

# Shared secret for signing JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Seed credentials for the initial admin user. Only used by `npm run seed`.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Comma-separated list of allowed CORS origins. Leave empty to deny cross-origin.
CORS_ALLOWED_ORIGINS=

# Rate limiting (per IP). Defaults: 15 min window, 100 requests.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Number of trusted proxy hops in front of the app (e.g. 1 behind a single ALB).
# Keep 0 when there is no proxy to prevent X-Forwarded-For spoofing.
TRUST_PROXY=0
